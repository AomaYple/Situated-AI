# 所有受控文本统一 LF；编码门禁负责确认 UTF-8 无 BOM。
* text=auto eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.csv text eol=lf
*.lock text eol=lf
*.frozen text eol=lf
/.gitattributes text eol=lf
/.gitignore text eol=lf
/.editorconfig text eol=lf
/LICENSE text eol=lf

# 二进制和原版镜像
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.dds binary
*.ico binary
*.prof binary
*.pyisession binary
research/situated/a2-evidence/raw/*.bin binary
# Steam 原始页面按抓取字节存证，不参与文本换行或空白规范化。
research/situated/a2-evidence/raw/*.html binary
research/situated/a2-evidence/**/*.gz binary
