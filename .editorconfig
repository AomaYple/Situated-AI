# 编辑器写盘约定；Git 入库与检出约定见 .gitattributes。
root = true

[*]
charset = utf-8
end_of_line = lf
# 保留生成物末尾与 Markdown 硬换行语义，避免编辑器自动改写。
insert_final_newline = false
trim_trailing_whitespace = false

[*.py]
indent_style = space
indent_size = 4
insert_final_newline = true

[*.txt]
# 游戏脚本保留 TAB 缩进；生成物仍由生成器维护。
indent_style = tab
