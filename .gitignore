# Situated AI：只忽略机器环境、缓存、可再生产物和本机证据。

# Python 环境和缓存
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
/.mypy_cache/
/.ruff_cache/
/.ruff-cache-*/
/.tox/
/.nox/
/.hypothesis/
/.cache/
/.benchmarks/
.coverage
.coverage.*

# 工具输出、报告和发布包
/tools/out/*
/tools/prof/out/
/dist/
/build/
/evidence/
/v3-parse-cache-*/
/tools/.benchmarks/
/tools/benchmarks/repo-audit-baseline.json
/tools/benchmarks/repo-audit-modules.json

# 保留可复核的精简快照和明确登记的证据
!/tools/out/snapshots/
/tools/out/snapshots/*
!/tools/out/snapshots/*.compact.json
!/tools/out/evidence/
/tools/out/evidence/*
!/tools/out/evidence/v0.1-g1-20261013/
/tools/out/evidence/v0.1-g1-20261013/*
!/tools/out/evidence/v0.1-g1-20261013/g1-reopen-scan-20261013.json

# 官方原文镜像只保留 manifest，原始文件按版权和体积不入库
/research/official-docs/

# 临时盘点、补丁和日志
/tools/_*.py
/tools/_*.txt
/tools/_*.md
*.tmp
*.temp
*.bak
*.orig
*.log
.commitmsg*

# 操作系统和编辑器
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store
$RECYCLE.BIN/
.vscode/
.idea/
*.swp
*.swo
*~
.project

# 协作工具运行态
.agent-teams/
.settings/
/.superpowers/
