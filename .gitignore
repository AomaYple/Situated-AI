# ─────────────────────────────────────────────────────────────
# 本仓库的忽略规则
#
# 原则：交付内容（文档 + 可复现脚本 + 研究资料）全部入库；
#       只排除「机器相关配置」「可重新生成的产物」与「工具垃圾」。
# ─────────────────────────────────────────────────────────────

# ── 机器相关配置 ───────────────────────────────────────────
# 本机 TLS 配置（含证书包，换机器即失效）
/.dsh/


# ── Python 虚拟环境 ────────────────────────────────────────
# 本地开发环境，体积大且机器相关，不入库。
# 依赖请记录到 requirements.txt（如果以后需要第三方包）。
/.venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.pip-tmp/

# pytest 在系统 Temp 不可写时会把 basetemp 落到仓库根目录，名字随机（pytest-cache-files-*）。
# pytest.ini 已用 --basetemp 固定到 .pytest-tmp/，这里再兜一层，
# 防止某次被强杀的运行留下无法删除的残留污染 git status。
pytest-cache-files-*/

# hypothesis 的属性测试数据库（记录反例，机器相关）
/.hypothesis/

# 基准测试基线（体积小，但含机器性能特征，不入库）
/.benchmarks/

# 覆盖率数据
.coverage
.coverage.*

# 单元测试的临时工作目录（测试自行创建与清理）
/.testtmp/
/.testtmp_*/


# ── tools/ 的中间产物 ──────────────────────────────────────
# 提取出的大型 JSON（约 9 MB），由 tools/ 下的 Python 工具重新生成
/tools/out/

# 性能剖析的原始数据（cProfile .prof 是二进制、pyinstrument session 是 JSON），
# 体积大且与机器相关。报告的结论请写进文档，原始数据不入库。
/tools/prof/out/

# 由 make_frags.ps1 从 tools/out/*.json 渲染出的 Markdown 片段
/tools/frag/

# 分块撰写的正文草稿。注意：这不是「可重新生成的产物」，
# 而是 assemble_doc.ps1 的输入；其内容已 100% 拼入 docs/ 下的成稿，
# 因此排除不会丢失任何信息（已验证 14/14 段全部命中成稿）。
/tools/docparts/


# 注意：tools/reports/ **已入库**。
# 它们是分析产物，但篇幅小（约 330 行）、且是「数量真值的单一来源」，
# 入库才能让文档一致性测试在无游戏环境下也有据可查。


# ── 操作系统垃圾 ───────────────────────────────────────────
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store
$RECYCLE.BIN/


# ── 编辑器 / IDE ───────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/


# ── 临时文件 ───────────────────────────────────────────────
*.tmp
*.temp
*.bak
*.orig
*.log


# ── 备注 ───────────────────────────────────────────────────
# research/ 已纳入版本控制，不忽略。
# 其中 official-docs/ 是游戏自带官方 .md 的逐字镜像（Paradox 版权内容），
# 公开分发前请自行评估。
#
# 注意：*.log 被忽略，但游戏日志位于用户数据目录（本仓库之外），不受影响。
.commitmsg*
.commitmsg
